{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(node scripts/board.mjs:*)",
      "Bash(node scripts/review.mjs:*)",
      "Bash(node scripts/tidy.mjs:*)",
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/build.sh:*)",
      "Bash(scripts/gen-docs.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/board.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/guard.mjs\""
          }
        ]
      }
    ]
  }
}
