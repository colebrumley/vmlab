-name
vmlab-vm-hvf234
-nodefaults
-no-user-config
-machine
virt
-accel
hvf
-cpu
host
-smp
4
-m
8192M
-kernel
/k/vmlinuz
-initrd
/k/initrd.img
-append
console=ttyAMA0 root=/dev/vda1
-dtb
/k/virt.dtb
-drive
if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap,file=/Users/someone/.vmlab/vms/vm-hvf234/disk.qcow2
-device
virtio-blk-pci,drive=disk0
-drive
if=none,id=seed,format=raw,readonly=on,file=/Users/someone/.vmlab/vms/vm-hvf234/seed.iso
-device
virtio-blk-pci,drive=seed
-netdev
user,id=net0,hostfwd=tcp:127.0.0.1:52222-:22,hostfwd=tcp:127.0.0.1:8080-:80,hostfwd=tcp:127.0.0.1:8443-:443
-device
virtio-net-pci,netdev=net0,mac=52:54:00:7f:9c:e6
-device
ramfb
-device
qemu-xhci
-device
usb-kbd
-device
usb-tablet
-device
virtio-keyboard-pci
-device
virtio-tablet-pci
-chardev
socket,id=qga0,path=/Users/someone/.vmlab/vms/vm-hvf234/qga.sock,server=on,wait=off
-device
virtio-serial-pci,id=vser0
-device
virtserialport,bus=vser0.0,chardev=qga0,name=org.qemu.guest_agent.0
-qmp
unix:/Users/someone/.vmlab/vms/vm-hvf234/qmp.sock,server,wait=off
-serial
unix:/Users/someone/.vmlab/vms/vm-hvf234/serial.sock,server,wait=off
-vnc
unix:/Users/someone/.vmlab/vms/vm-hvf234/vnc.sock
-gdb
tcp:127.0.0.1:41234
-pidfile
/Users/someone/.vmlab/vms/vm-hvf234/qemu.pid
-display
none
-daemonize
-S
