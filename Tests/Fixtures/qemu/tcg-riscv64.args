-name
vmlab-vm-tcgrv6
-nodefaults
-no-user-config
-machine
virt
-accel
tcg
-cpu
max
-smp
8
-m
2048M
-drive
if=pflash,format=raw,unit=0,readonly=on,file=/opt/homebrew/share/qemu/edk2-riscv-code.fd
-drive
if=pflash,format=raw,unit=1,file=/Users/someone/.vmlab/vms/vm-tcgrv6/efi-vars.bin
-drive
if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap,file=/Users/someone/.vmlab/vms/vm-tcgrv6/disk.qcow2
-device
virtio-blk-pci,drive=disk0,bootindex=0
-netdev
user,id=net0,hostfwd=tcp:127.0.0.1:2222-:22
-device
virtio-net-pci,netdev=net0,mac=52:54:00:fe:ce:4f
-device
ramfb
-device
qemu-xhci
-device
usb-kbd
-device
usb-tablet
-device
virtio-keyboard-pci
-device
virtio-tablet-pci
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcgrv6/qmp.sock,server,wait=off
-serial
unix:/Users/someone/.vmlab/vms/vm-tcgrv6/serial.sock,server,wait=off
-vnc
unix:/Users/someone/.vmlab/vms/vm-tcgrv6/vnc.sock
-pidfile
/Users/someone/.vmlab/vms/vm-tcgrv6/qemu.pid
-display
none
-daemonize
-S
