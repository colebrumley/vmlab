-name
vmlab-vm-tcgx86
-nodefaults
-no-user-config
-machine
q35
-accel
tcg
-cpu
max
-smp
1
-m
2048M
-bios
/fw/seabios.bin
-drive
if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap,file=/Users/someone/.vmlab/vms/vm-tcgx86/disk.qcow2
-device
virtio-blk-pci,drive=disk0,bootindex=0
-netdev
user,id=net0,hostfwd=tcp:127.0.0.1:2222-:22
-device
virtio-net-pci,netdev=net0,mac=52:54:00:cb:8a:b3
-device
ramfb
-device
qemu-xhci
-device
usb-kbd
-device
usb-tablet
-device
virtio-keyboard-pci
-device
virtio-tablet-pci
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcgx86/qmp.sock,server,wait=off
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcgx86/qmp2.sock,server,wait=off
-serial
unix:/Users/someone/.vmlab/vms/vm-tcgx86/serial.sock,server,wait=off
-vnc
unix:/Users/someone/.vmlab/vms/vm-tcgx86/vnc.sock
-gdb
tcp:127.0.0.1:1234
-pidfile
/Users/someone/.vmlab/vms/vm-tcgx86/qemu.pid
-display
none
-daemonize
-S
