-name
vmlab-vm-tcga64
-nodefaults
-no-user-config
-machine
virt
-accel
tcg
-cpu
max
-smp
2
-m
4096M
-drive
if=pflash,format=raw,unit=0,readonly=on,file=/opt/homebrew/share/qemu/edk2-aarch64-code.fd
-drive
if=pflash,format=raw,unit=1,file=/Users/someone/.vmlab/vms/vm-tcga64/efi-vars.bin
-drive
if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap,file=/Users/someone/.vmlab/vms/vm-tcga64/disk.qcow2
-device
virtio-blk-pci,drive=disk0,bootindex=0
-drive
if=none,id=seed,format=raw,readonly=on,file=/Users/someone/.vmlab/vms/vm-tcga64/seed.iso
-device
virtio-blk-pci,drive=seed
-nic
none
-device
ramfb
-device
qemu-xhci
-device
usb-kbd
-device
usb-tablet
-device
virtio-keyboard-pci
-device
virtio-tablet-pci
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcga64/qmp.sock,server,wait=off
-serial
unix:/Users/someone/.vmlab/vms/vm-tcga64/serial.sock,server,wait=off
-vnc
unix:/Users/someone/.vmlab/vms/vm-tcga64/vnc.sock
-pidfile
/Users/someone/.vmlab/vms/vm-tcga64/qemu.pid
-display
none
-daemonize
-S
