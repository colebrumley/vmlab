-name
vmlab-vm-hvf234
-nodefaults
-no-user-config
-machine
virt
-accel
hvf
-cpu
host
-smp
4
-m
8192M
-drive
if=pflash,format=raw,unit=0,readonly=on,file=/opt/homebrew/share/qemu/edk2-aarch64-code.fd
-drive
if=pflash,format=raw,unit=1,file=/Users/someone/.vmlab/vms/vm-hvf234/efi-vars.bin
-drive
if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap,file=/Users/someone/.vmlab/vms/vm-hvf234/disk.qcow2
-device
virtio-blk-pci,drive=disk0,bootindex=0
-netdev
user,id=net0,hostfwd=tcp:127.0.0.1:52222-:22,hostfwd=tcp:127.0.0.1:8080-:80,hostfwd=tcp:127.0.0.1:49152-:443
-device
virtio-net-pci,netdev=net0,mac=52:54:00:7f:9c:e6
-device
ramfb
-device
qemu-xhci
-device
usb-kbd
-device
usb-tablet
-device
virtio-keyboard-pci
-device
virtio-tablet-pci
-chardev
socket,id=qga0,path=/Users/someone/.vmlab/vms/vm-hvf234/qga.sock,server=on,wait=off
-device
virtio-serial-pci,id=vser0
-device
virtserialport,bus=vser0.0,chardev=qga0,name=org.qemu.guest_agent.0
-qmp
unix:/Users/someone/.vmlab/vms/vm-hvf234/qmp.sock,server,wait=off
-qmp
unix:/Users/someone/.vmlab/vms/vm-hvf234/qmp2.sock,server,wait=off
-chardev
socket,id=serial0,path=/Users/someone/.vmlab/vms/vm-hvf234/serial.sock,server=on,wait=off,logfile=/Users/someone/.vmlab/vms/vm-hvf234/console.log,logappend=on
-serial
chardev:serial0
-vnc
unix:/Users/someone/.vmlab/vms/vm-hvf234/vnc.sock
-gdb
tcp:127.0.0.1:41234
-pidfile
/Users/someone/.vmlab/vms/vm-hvf234/qemu.pid
-display
none
-daemonize
-S
