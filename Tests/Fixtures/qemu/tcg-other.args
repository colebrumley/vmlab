-name
vmlab-vm-tcgppc
-nodefaults
-no-user-config
-machine
virt
-accel
tcg
-smp
2
-m
1024M
-kernel
/k/vmlinux
-append
console=hvc0
-nic
none
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcgppc/qmp.sock,server,wait=off
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcgppc/qmp2.sock,server,wait=off
-chardev
socket,id=serial0,path=/Users/someone/.vmlab/vms/vm-tcgppc/serial.sock,server=on,wait=off,logfile=/Users/someone/.vmlab/vms/vm-tcgppc/console.log,logappend=on
-serial
chardev:serial0
-vnc
unix:/Users/someone/.vmlab/vms/vm-tcgppc/vnc.sock
-pidfile
/Users/someone/.vmlab/vms/vm-tcgppc/qemu.pid
-display
none
-daemonize
-S
