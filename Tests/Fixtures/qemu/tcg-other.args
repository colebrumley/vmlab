-name
vmlab-vm-tcgppc
-nodefaults
-no-user-config
-machine
virt
-accel
tcg
-smp
2
-m
1024M
-kernel
/k/vmlinux
-append
console=hvc0
-nic
none
-qmp
unix:/Users/someone/.vmlab/vms/vm-tcgppc/qmp.sock,server,wait=off
-serial
unix:/Users/someone/.vmlab/vms/vm-tcgppc/serial.sock,server,wait=off
-vnc
unix:/Users/someone/.vmlab/vms/vm-tcgppc/vnc.sock
-pidfile
/Users/someone/.vmlab/vms/vm-tcgppc/qemu.pid
-display
none
-daemonize
-S
