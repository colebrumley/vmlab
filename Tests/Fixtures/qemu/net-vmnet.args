-name
vmlab-vm-net234
-nodefaults
-no-user-config
-machine
virt
-accel
hvf
-cpu
host
-smp
2
-m
4096M
-drive
if=pflash,format=raw,unit=0,readonly=on,file=/opt/homebrew/share/qemu/edk2-aarch64-code.fd
-drive
if=pflash,format=raw,unit=1,file=/Users/someone/.vmlab/vms/vm-net234/efi-vars.bin
-drive
if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap,file=/Users/someone/.vmlab/vms/vm-net234/disk.qcow2
-device
virtio-blk-pci,drive=disk0,bootindex=0
-netdev
vmnet-shared,id=net0
-device
virtio-net-pci,netdev=net0,mac=52:54:00:e3:ba:db
-device
ramfb
-device
qemu-xhci
-device
usb-kbd
-device
usb-tablet
-device
virtio-keyboard-pci
-device
virtio-tablet-pci
-qmp
unix:/Users/someone/.vmlab/vms/vm-net234/qmp.sock,server,wait=off
-serial
unix:/Users/someone/.vmlab/vms/vm-net234/serial.sock,server,wait=off
-vnc
unix:/Users/someone/.vmlab/vms/vm-net234/vnc.sock
-pidfile
/Users/someone/.vmlab/vms/vm-net234/qemu.pid
-display
none
-daemonize
-S
